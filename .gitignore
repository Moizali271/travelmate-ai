# ==========================================
# TravelMate AI - Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyd
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
wheels/

# Node.js
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
build/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Local backup files
*backup*.txt
*_backup.*
*.bak
*.old
*.orig

# Local databases and generated files
*.sqlite
*.sqlite3
*.db-journal

# Test and debug output
playwright-report/
test-results/

# Local environment files
.vercel/